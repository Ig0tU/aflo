# Database — leave as-is for SQLite demo, or point at Postgres
DATABASE_URL=sqlite+aiosqlite:///./aflo.db

# For Docker Postgres:
# DATABASE_URL=postgresql+asyncpg://aflo:aflo@localhost:5432/aflo

# Optional: OpenAI-compatible endpoint for follow-up question generation
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

APP_ENV=development
LOG_LEVEL=INFO
